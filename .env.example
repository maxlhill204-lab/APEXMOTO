# Public origin used for metadata, redirects, and Stripe Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout fails closed unless every required order-system value below exists.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Neon Postgres. Run `npm run db:migrate` after adding this locally.
DATABASE_URL=

# Resend transactional email. ORDER_EMAIL_FROM must use a verified sender/domain.
RESEND_API_KEY=
ORDER_EMAIL_FROM=APEX MOTO Orders <orders@example.com>
STORE_ORDER_EMAIL=apexmotostore.au@gmail.com

# Generate independent random values; use at least 32 characters for secrets.
ORDER_ACCESS_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Kept server-only. Included in confirmed pickup emails; never rendered publicly.
PICKUP_ADDRESS_PRIVATE=

# Optional privacy-conscious analytics flag. No provider is loaded by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional contact form endpoint/provider token. Without it, direct email links remain available.
CONTACT_FORM_ENDPOINT=
