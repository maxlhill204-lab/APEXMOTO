# Public origin used for metadata, redirects, and Stripe Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout fails closed unless every required order-system value below exists.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Neon Postgres. Run `npm run db:migrate` after adding this locally.
DATABASE_URL=

# Postmark is primary; Resend is the automatic fallback. Configure both in production.
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
ORDER_EMAIL_FROM=APEX MOTO Orders <orders@apexmoto.com.au>
STORE_ORDER_EMAIL=apexmotostore.au@gmail.com

# Generate independent random values; use at least 32 characters for secrets.
ORDER_ACCESS_SECRET=
# Exactly six digits. Do not reuse a banking, device, or other personal PIN.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Kept server-only. Included in confirmed pickup emails; never rendered publicly.
PICKUP_ADDRESS_PRIVATE=

# Optional privacy-conscious analytics flag. No provider is loaded by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional contact form endpoint/provider token. Without it, direct email links remain available.
CONTACT_FORM_ENDPOINT=

# Australia Post calculated shipping. The live storefront keeps the existing
# Australian rates until every required measurement and credential is present.
# Register for the Postage Assessment Calculator (PAC), not the contract-only
# Shipping & Tracking API, to obtain this key.
AUSPOST_PAC_API_KEY=
# Optional for the official Australia Post test endpoint during development.
AUSPOST_PAC_BASE_URL=https://digitalapi.auspost.com.au
# At least 32 random characters. Signs short-lived server-owned rate quotes.
SHIPPING_QUOTE_SECRET=
# Comma-separated ISO alpha-2 destinations. Australia must remain included.
AUSPOST_SHIPPING_COUNTRIES=AU,NZ,GB,DE,FR,IT,ES,NL,BE,AT,IE,PT,DK,SE,NO,FI,CH,PL,CZ,US,CA,JP,SG

# Measure the real, ready-to-mail packages. Kilograms and centimetres only.
AUSPOST_HELMET_PACKED_WEIGHT_KG=
AUSPOST_HELMET_LENGTH_CM=
AUSPOST_HELMET_WIDTH_CM=
AUSPOST_HELMET_HEIGHT_CM=
AUSPOST_HELMET_ITEM_WEIGHT_KG=
AUSPOST_GOGGLES_PACKED_WEIGHT_KG=
AUSPOST_GOGGLES_ADDON_WEIGHT_KG=
AUSPOST_GOGGLES_LENGTH_CM=
AUSPOST_GOGGLES_WIDTH_CM=
AUSPOST_GOGGLES_HEIGHT_CM=
AUSPOST_GOGGLES_ITEM_WEIGHT_KG=
AUSPOST_GOGGLES_UNITS_PER_PARCEL=
AUSPOST_BAG_ITEM_WEIGHT_KG=

# Customs facts for commercial international parcels. Do not guess these.
# Descriptions must be specific and no longer than 40 characters. HS codes are
# 6-12 digits. Countries of origin are the two-letter countries of manufacture.
CUSTOMS_HELMET_DESCRIPTION=
CUSTOMS_HELMET_HS_CODE=
CUSTOMS_HELMET_COUNTRY_OF_ORIGIN=
CUSTOMS_GOGGLES_DESCRIPTION=
CUSTOMS_GOGGLES_HS_CODE=
CUSTOMS_GOGGLES_COUNTRY_OF_ORIGIN=
CUSTOMS_BAG_DESCRIPTION=
CUSTOMS_BAG_HS_CODE=
CUSTOMS_BAG_COUNTRY_OF_ORIGIN=
CUSTOMS_BAG_UNIT_VALUE_CENTS=
