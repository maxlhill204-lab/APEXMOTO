# Public origin used for metadata, redirects, and Stripe Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Stripe configuration. The storefront and cart work without these.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional privacy-conscious analytics flag. No provider is loaded by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional contact form endpoint/provider token. Without it, direct email links remain available.
CONTACT_FORM_ENDPOINT=
